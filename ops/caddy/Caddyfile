{
	# Caddy global options.
	#
	# `email` enables Let's Encrypt issuance (used in the ACME account
	# registration). Use a real address — Let's Encrypt notifies on cert
	# expiry / revocation events.
	email eliot@fxmilyapp.com

	# Logs to file — rolled by Caddy itself (no logrotate dependency).
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 7
		}
		format json
		level INFO
	}
}

app.fxmilyapp.com {
	# Reverse proxy to the `web` container (compose-network DNS).
	reverse_proxy web:3000 {
		# `lb_try_duration` retries upstream until container healthcheck
		# reports healthy (60s window covers most rolling deploys).
		lb_try_duration 60s
		lb_try_interval 1s
		# Trust the X-Forwarded-* chain only because we terminate TLS
		# here (Caddy is the FIRST hop after the public IP). Caddy is
		# single-hop, so we OVERWRITE X-Forwarded-For with `{remote_host}`
		# (the TCP-layer client IP, non-spoofable) rather than appending
		# to a potentially attacker-supplied value. This aligns with
		# `callerIdTrusted` (apps/web/src/lib/rate-limit/token-bucket.ts)
		# which reads the LAST entry of XFF expecting a trusted Caddy-set
		# value.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Defence-in-depth headers (Caddy-side ; Next.js also emits CSP +
	# X-Frame-Options + Referrer-Policy via next.config.ts headers()).
	# HSTS preload-eligible : 2 years, includeSubDomains, preload.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		# Cross-origin isolation (lets us use SharedArrayBuffer if ever needed
		# for V2 audio analysis — opt-out by removing if it conflicts).
		Cross-Origin-Opener-Policy "same-origin"
		# Permissions stripped at the edge in addition to next.config.ts.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		# Caddy reveals its version by default — strip it.
		-Server
	}

	# Compress everything text-y. Caddy negotiates per-Accept-Encoding.
	# NOTE: `br` (brotli) is intentionally NOT listed — the official
	# `caddy:2-alpine` image ships WITHOUT the brotli encoder module
	# (`http.encoders.br` is not registered), so `encode zstd br gzip`
	# makes `caddy adapt`/reload FAIL ("module not registered: http.encoders.br")
	# and leaves the proxy unable to serve TLS (origin 522). The prod host
	# Caddyfile was hot-patched to `zstd gzip`; this keeps the repo (IaC source
	# of truth) in sync so a future deploy/reload never re-breaks the edge.
	# To re-enable brotli, build a custom caddy image with the brotli plugin first.
	encode zstd gzip

	# Per-domain access log (in addition to the global log block).
	log {
		output file /var/log/caddy/fxmily.log {
			roll_size 100MiB
			roll_keep 7
		}
		format json
	}
}

# Marketing / public landing : redirects to the app for V1 (no public
# marketing site yet).
#
# DO NOT remove this block "because V2 has a landing page" without first
# removing `tls internal` from the equation: these two names are
# Cloudflare-PROXIED, so a Caddy site block for them WILL attempt public ACME
# the moment `tls internal` goes away, and public ACME cannot validate a
# proxied name from here (tls-alpn-01 terminates at Cloudflare's edge,
# http-01 is bounced to an https:// URL with no cert yet). While the apex was
# dead this was harmless; now that it reaches the origin it would be a
# visible outage on a live hostname.
#
# WHY 522 HAPPENED — settled by measurement on 2026-08-05, and the earlier
# explanation in this file was WRONG. It blamed the ACME loop above. It was
# not that: the certificate existed on disk, Caddy answered a local TLS
# handshake for the apex, and ufw allowed 443 from anywhere. The real cause
# was DNS — the proxied A records for `fxmilyapp.com` and `www` pointed at
# 216.40.34.41, the REGISTRAR'S PARKING IP (same provider as the apex MX,
# `mx.hover.com.cust.hostedemail.com`), so Cloudflare was dialling a machine
# that does not serve this domain and timed out. Both records now point at
# the same origin as `app`. Cloudflare "Full" (NOT strict — verified in the
# dashboard) accepts Caddy's internal CA for the CF→origin hop.
#
# `temporary` (302), NOT `permanent`. A 301 without Cache-Control is cached by
# browsers indefinitely: every visitor who ever hit the apex would be pinned
# to this redirect and would NEVER see the V2 landing page this block is
# meant to be replaced by. That trap was inert while the apex returned 522;
# repointing the DNS armed it for every visitor. Switch back to `permanent`
# only once the apex is meant to redirect forever.
www.fxmilyapp.com, fxmilyapp.com {
	tls internal

	# These two hostnames became a LIVE public surface on 2026-08-05. Before
	# that they returned 522 and served nothing, so the absence of headers
	# here cost nothing. It costs something now: without HSTS a visitor's
	# first hop is in the clear and nothing protects the next one — the HSTS
	# on `app.fxmilyapp.com` covers subdomains OF app, not the apex.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}

	redir https://app.fxmilyapp.com{uri} temporary
}

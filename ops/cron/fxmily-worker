#!/usr/bin/env bash
# /usr/local/bin/fxmily-worker — run ONE Fxmily AI batch on the server (J9).
#
# WHY THIS EXISTS. Until J9 the 7 `claude --print` pipelines ran on Eliott's
# Windows PC via Task Scheduler (`ops/worker/install-worker.ps1`): PC off = zero
# AI generation for every member. J9 moves them to the always-on host. This
# wrapper is to `ops/worker/run-batch.sh` exactly what `/usr/local/bin/fxmily-cron`
# is to the `/api/cron/*` routes: the ONE line shape `/etc/cron.d/fxmily-worker`
# is allowed to use, holding everything cron does NOT give you for free —
# a usable PATH, a real HOME, a bounded route allowlist, a central log, an
# optional dead-man's-switch ping, and CPU/IO politeness towards the app
# containers that share this box.
#
# It deliberately does NOT re-implement any worker semantics. The global lock,
# the jittered sleeps, the quota cooldown stamp, the `claude auth status`
# pre-flight, `status.json` and the exit-75 remap all live in run-batch.sh and
# claude-batch-core.sh and are PORTED AS-IS (J9 contract: preserve, never
# reinvent — those are the anti-ban protections).
#
# Usage :
#   fxmily-worker <batch> [-- <extra args forwarded to the batch script>]
#     e.g. fxmily-worker onboarding
#          fxmily-worker weekly -- --dry-run
#
# Sources : /etc/fxmily/cron.env (CRON_LOG + optional HEALTHCHECK_PING_URL_WORKER_*).
#           Absent or unreadable is NOT fatal here (unlike fxmily-cron, which
#           needs CRON_SECRET to do anything): this wrapper's secrets live in
#           the checkout's `ops/worker/worker.env`, sourced by run-batch.sh.
# Logs to : $WORKER_LOG (default /var/log/fxmily/worker.log).
#
# Exit codes : whatever run-batch.sh returned. 0 = ran fine, or a BENIGN skip
# (lock held by another batch, quota cooldown, no Claude account logged in,
# usage cap remapped from 75). Non-zero = the underlying batch really failed.

set -uo pipefail # NOT -e : we always want the log line + the ping to happen.

BATCH="${1:-}"
if [[ -z "$BATCH" ]]; then
  echo "usage: fxmily-worker <onboarding|weekly|monthly|calendar|verification|profile|seances> [-- args]" >&2
  exit 2
fi
shift

# Everything after a literal `--` is forwarded verbatim to the batch script
# (`--dry-run`, `--max-members 1`, ...). Mirrors run-batch.sh's own contract.
EXTRA_ARGS=()
if [[ "${1:-}" == "--" ]]; then
  shift
  EXTRA_ARGS=("$@")
fi

# Allowlist — same rationale as fxmily-cron's: `$BATCH` reaches a script path,
# so a compromise of /etc/cron.d/* must not be able to point it anywhere else.
# run-batch.sh validates again on its side (defense in depth).
case "$BATCH" in
  onboarding | weekly | monthly | calendar | verification | profile | seances) ;;
  *)
    echo "[fxmily-worker] batch '$BATCH' is not in the allowlist" >&2
    exit 2
    ;;
esac

# --- Environment cron does not give you -------------------------------------
# cron runs with PATH=/usr/local/bin:/usr/bin:/bin and no login shell, so the
# npm user prefix (where `claude` lives) is invisible. HOME matters twice over:
# `claude` reads its OAuth from $HOME/.claude/.credentials.json, and run-batch.sh
# puts its MACHINE-GLOBAL lock at $HOME/.fxmily-worker.lock — an empty HOME
# would silently create a SECOND "global" lock and break the one-claude-at-a-time
# guarantee that is the whole anti-ban design.
WORKER_USER_HOME="${WORKER_USER_HOME:-$(getent passwd "$(id -un)" | cut -d: -f6)}"
export HOME="${HOME:-$WORKER_USER_HOME}"
export PATH="$HOME/.npm-global/bin:$HOME/bin:/usr/local/bin:/usr/bin:/bin"

# Dedicated checkout (J9 contract: a checkout SEPARATE from anything else).
WORKER_REPO="${FXMILY_WORKER_REPO:-$HOME/worker}"
RUN_BATCH="$WORKER_REPO/ops/worker/run-batch.sh"
if [[ ! -f "$RUN_BATCH" ]]; then
  echo "[fxmily-worker] run-batch.sh not found at $RUN_BATCH (FXMILY_WORKER_REPO?)" >&2
  exit 2
fi

# Optional operator config (log path + Healthchecks.io URLs). Best-effort.
if [[ -r /etc/fxmily/cron.env ]]; then
  # shellcheck disable=SC1091
  source /etc/fxmily/cron.env
fi

WORKER_LOG="${WORKER_LOG:-/var/log/fxmily/worker.log}"
mkdir -p "$(dirname "$WORKER_LOG")" 2>/dev/null || true

ts() { date -u +'%Y-%m-%dT%H:%M:%SZ'; }

# --- OBSERVATION MODE (J9 scope 4 — the controlled switchover) ---------------
# `FXMILY_WORKER_DRY_RUN=1` in /etc/fxmily/cron.env forces every scheduled tick
# to run with `--dry-run`: the server is pulled, the generation is exercised for
# real, and NOTHING is persisted. That is the doublon window — the PC stays
# master, the server proves it can do the work, and the two outputs can be
# compared before anything member-facing changes.
#
# The switch is deliberately ONE line in ONE file, not a crontab edit:
#   observation → production :  FXMILY_WORKER_DRY_RUN=0   (or delete the line)
#   production  → observation :  FXMILY_WORKER_DRY_RUN=1   (instant rollback)
# No file is re-installed, no schedule is touched, and the change takes effect
# on the very next tick. A rollback you can perform in five seconds under
# pressure is the only kind that actually gets performed.
if [[ "${FXMILY_WORKER_DRY_RUN:-0}" == "1" ]]; then
  case " ${EXTRA_ARGS[*]-} " in
    *" --dry-run "*) ;;
    *) EXTRA_ARGS+=(--dry-run) ;;
  esac
fi

# --- Dead-man's switch (Healthchecks.io), env-gated and no-op by default -----
# Same convention as the host backup crons: one URL per check, BLANK = disabled
# so the wrapper is a silent no-op until Eliott pastes real URLs. The variable
# name is derived from the batch: HEALTHCHECK_PING_URL_WORKER_ONBOARDING, ...
# `/start` marks the run as in-flight, the bare URL marks success, `/fail`
# marks a real failure. A benign skip pings SUCCESS on purpose: the check
# answers "is this pipeline still being ticked", not "did it have work to do".
HC_VAR="HEALTHCHECK_PING_URL_WORKER_$(printf '%s' "$BATCH" | tr '[:lower:]' '[:upper:]')"
HC_URL="${!HC_VAR:-}"

hc_ping() {
  local suffix="${1:-}"
  [[ -z "$HC_URL" ]] && return 0
  curl --silent --show-error --max-time 15 --retry 2 --retry-delay 2 \
    -o /dev/null "${HC_URL}${suffix}" 2>>"$WORKER_LOG" || true
}

START_TS="$(ts)"
hc_ping "/start"

# --- Run ---------------------------------------------------------------------
# `nice`/`ionice` : the AI batches share this box with fxmily-web + Postgres
# (ADR-006 — one host, no second VPS, interdit ❶). A `claude --print` run is
# mostly network-wait, but the CLI still spawns a Node process per member; being
# polite costs nothing and removes any doubt that member-facing latency could
# ever regress because a batch is running.
NICE=(nice -n 10)
command -v ionice >/dev/null 2>&1 && NICE+=(ionice -c2 -n7)

# Wall-clock ceiling — the Linux equivalent of the Windows task's
# `ExecutionTimeLimit 2h` (install-worker.ps1). cron gives you nothing here, and
# the lock's stale-reclaim only kicks in at 150 min, so without this a wedged
# batch would starve every other pipeline for 2h30. SIGTERM (not KILL) so
# run-batch.sh's TERM trap still runs: it writes status.json and RELEASES the
# lock. `--kill-after` is the last resort if the trap itself is stuck.
BATCH_TIMEOUT="${FXMILY_WORKER_TIMEOUT:-2h}"
TIMEOUT_CMD=()
if command -v timeout >/dev/null 2>&1 && [[ "$BATCH_TIMEOUT" != "0" ]]; then
  TIMEOUT_CMD=(timeout --kill-after=60s "$BATCH_TIMEOUT")
fi

"${TIMEOUT_CMD[@]}" "${NICE[@]}" bash "$RUN_BATCH" "$BATCH" \
  ${EXTRA_ARGS[0]+-- "${EXTRA_ARGS[@]}"} >>"$WORKER_LOG" 2>&1
EXIT_CODE=$?

END_TS="$(ts)"

MODE_TAG=$([[ "${FXMILY_WORKER_DRY_RUN:-0}" == "1" ]] && echo "observation" || echo "persist")

if [[ "$EXIT_CODE" -eq 0 ]]; then
  echo "[$END_TS] [fxmily-worker] $BATCH OK mode=$MODE_TAG ($START_TS → $END_TS)" >>"$WORKER_LOG"
  hc_ping ""
else
  echo "[$END_TS] [fxmily-worker] $BATCH FAIL exit=$EXIT_CODE mode=$MODE_TAG ($START_TS → $END_TS)" >>"$WORKER_LOG"
  hc_ping "/fail"
fi

exit "$EXIT_CODE"

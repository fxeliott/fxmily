#!/usr/bin/env bash
# /usr/local/bin/fxmily-worker-watchdog — server-side worker watchdog (J9).
#
# Linux port of `ops/worker/watchdog.ps1` (tour 12/17). Same contract, same
# heartbeat endpoint, same bounded `errorLabels` vocabulary — so
# `/admin/system` (WORKER_EXPECTATIONS + LABEL_HOST_ACTIONS in
# apps/web/src/lib/system/health.ts) keeps working byte-for-byte after the
# Windows → VPS move, with no server-side change to the label contract.
#
# WHAT IT CHECKS, every 30 min :
#   1. CONFIG    ops/worker/worker.env present + every token ≥ 32 chars.
#   2. SCHEDULE  one /etc/cron.d/fxmily-worker line per pipeline (the Linux
#                equivalent of "the scheduled task is registered"), the file is
#                readable by crond (mode 0644, root-owned) and free of CR.
#   3. AUTH      `claude auth status --json` LIVE. This is the single most
#                valuable signal on this box: a logged-out account means the 7
#                batches generate NOTHING while every age-based heartbeat stays
#                green (the exact "IA muette" incident). It maps to the
#                `claude_auth:logged_out` label, which `health.ts` escalates to
#                RED via `criticalLabels`.
#                (The Windows watchdog had to INFER this from a fresh
#                status.json because it could not always reach the CLI; here we
#                just ask the CLI — strictly more accurate.)
#   4. RUNS      each pipeline's `logs/<batch>.status.json` — quota cap
#                (benign, self-resolving) and real failures.
#                NOT staleness: this step reads the CONTENT of whatever status
#                file is there and never looks at its age, so a three-week-old
#                `ok:true` replays as healthy here. That is deliberate, not an
#                oversight — "this pipeline stopped running" is exactly what the
#                age-based heartbeat on `<pipeline>.batch.pulled` measures, from
#                the server's own audit rows rather than from a file on this box.
#                Duplicating it here would mean two clocks disagreeing at 2am.
#   5. LOCK      a global lock older than 6h is a stuck holder.
#   6. REPORT    POST /api/admin/worker-watchdog/heartbeat (X-Admin-Token).
#
# WHAT IT DOES NOT DO. It does not "repair" the schedule. On Windows a task
# could silently unregister or drift to S4U, so the watchdog re-ran the
# installer. A /etc/cron.d file does not drift by itself: if it is gone, a human
# (or a bad deploy) removed it, and silently re-writing a root-owned file from a
# cron job would be a privilege-escalation shaped hole for a benefit that does
# not exist here. So we REPORT `task_missing:<batch>` and let `/admin/system`
# surface the one command to run. Honest beats magic.
#
# Exit code: 0 whenever the heartbeat was DELIVERED (errors travel INSIDE the
# heartbeat, that is the whole design); 1 only when the heartbeat itself could
# not be sent — and that absence is exactly what the board's
# `worker.watchdog.heartbeat` entry flags.

set -uo pipefail

WATCHDOG_VERSION="j9-1.0"

WORKER_USER_HOME="${WORKER_USER_HOME:-$(getent passwd "$(id -un)" | cut -d: -f6)}"
export HOME="${HOME:-$WORKER_USER_HOME}"
export PATH="$HOME/.npm-global/bin:$HOME/bin:/usr/local/bin:/usr/bin:/bin"

WORKER_REPO="${FXMILY_WORKER_REPO:-$HOME/worker}"
WORKER_DIR="$WORKER_REPO/ops/worker"
ENV_FILE="$WORKER_DIR/worker.env"
LOG_DIR="${FXMILY_WORKER_LOG_DIR:-$WORKER_DIR/logs}"
CRON_FILE="${FXMILY_WORKER_CRON_FILE:-/etc/cron.d/fxmily-worker}"
LOCK_DIR="${FXMILY_WORKER_LOCK_DIR:-$HOME/.fxmily-worker.lock}"

if [[ -r /etc/fxmily/cron.env ]]; then
  # shellcheck disable=SC1091
  source /etc/fxmily/cron.env
fi
# Identical to the wrapper's, and it HAS to be. These two readers already cost
# this jalon one incident by disagreeing on the default (`:-1` here vs `:-0`
# there) — the watchdog then called a healthy host logged out. A CR stripped in
# one reader and not the other reproduces that class exactly: the wrapper would
# run in observation while the watchdog reported on a production host.
# `:-` first for the same reason as there: `set -u` is active and the key is
# legitimately absent on a fresh host.
# Same reasoning as `fxmily-worker`: the CR is a property of the file, not of one
# key, and blanks flip the same door. A CR surviving on FXMILY_WORKER_LOG_DIR or
# FXMILY_WORKER_CRON_FILE would make this watchdog read a directory that does not
# exist and report every pipeline missing — a red board for an invisible byte.
_norm() { # $1 = variable NAME. Strips every CR, then leading/trailing blanks.
  local _v="${!1:-}"
  _v="${_v//$'\r'/}"
  _v="${_v#"${_v%%[![:space:]]*}"}"
  _v="${_v%"${_v##*[![:space:]]}"}"
  printf -v "$1" '%s' "$_v"
}
for _k in FXMILY_WORKER_DRY_RUN FXMILY_BASE_URL FXMILY_WORKER_CRON_FILE \
          FXMILY_WORKER_LOCK_DIR FXMILY_WORKER_LOG_DIR FXMILY_WORKER_REPO WORKER_LOG; do
  _norm "$_k"
done
WATCHDOG_LOG="${WORKER_LOG:-/var/log/fxmily/worker.log}"
mkdir -p "$(dirname "$WATCHDOG_LOG")" 2>/dev/null || true

ts() { date -u +'%Y-%m-%dT%H:%M:%SZ'; }
log() { echo "[$(ts)] [watchdog] $*" >>"$WATCHDOG_LOG"; }

# The 7 pipelines the worker owns. `seances` joined the contract in J9 (scope 5).
PIPELINES=(onboarding verification seances calendar weekly monthly profile)

# Bounded, machine-readable labels. The server caps this at 20 entries of ≤120
# chars (worker-watchdog/heartbeat route Zod schema) — never a token, never a
# path, never a local username (§21.5 PII-free).
ERROR_LABELS=()
add_label() { ERROR_LABELS+=("$1"); }

TASKS_OK=0

# --- 1. CONFIG ---------------------------------------------------------------
ADMIN_TOKEN=""

# `worker.env` is written by hand as often as by the installer, so a value may
# arrive quoted (KEY="…") or carrying a CR from a Windows editor. run-batch.sh
# already strips both before using a token; this watchdog has to strip them the
# SAME way. Reading a quoted token raw would send `X-Admin-Token: "…"`, get a
# 401 on every heartbeat, and turn the watchdog entry red — an alarm about the
# watchdog while the watchdog is fine and the quoting is the only bug.
unwrap() {
  local v="$1"
  v="${v%$'\r'}"
  v="${v#\"}"
  v="${v%\"}"
  v="${v#\'}"
  v="${v%\'}"
  printf '%s' "$v"
}

if [[ ! -r "$ENV_FILE" ]]; then
  add_label 'config_missing:worker.env'
else
  # Read token lengths WITHOUT ever echoing a value.
  while IFS='=' read -r key val; do
    [[ "$key" =~ ^FXMILY_.*TOKEN$ ]] || continue
    val="$(unwrap "$val")"
    if [[ "${#val}" -lt 32 ]]; then add_label "token_short:$key"; fi
    [[ "$key" == "FXMILY_ADMIN_TOKEN" ]] && ADMIN_TOKEN="$val"
  done < <(grep -E '^FXMILY_[A-Z_]*TOKEN=' "$ENV_FILE" || true)
  BASE_URL="$(unwrap "$(grep -E '^FXMILY_BASE_URL=' "$ENV_FILE" | head -1 | cut -d= -f2- || true)")"
fi
BASE_URL="${FXMILY_BASE_URL:-${BASE_URL:-https://app.fxmilyapp.com}}"

# --- 2. SCHEDULE -------------------------------------------------------------
if [[ ! -r "$CRON_FILE" ]]; then
  add_label 'cron_file_missing'
  for p in "${PIPELINES[@]}"; do add_label "task_missing:$p"; done
else
  # crond ignores a /etc/cron.d file that is group/other-writable, and SILENTLY
  # skips any line containing a CR (the exact ~20h outage of 2026-05-11, V1.6
  # bug #2). Both are invisible failures — check them explicitly.
  # What crond actually refuses is a file that is group- or other-WRITABLE. It
  # does not care about the read bits, so `600` and `640` are read perfectly.
  # Testing `!= 644` therefore raised the same label for a fatal `664` and for a
  # harmless `600` — one label meaning two opposite things, which is why the
  # board classified the whole family as "hygiene" and gave it no action at all.
  # Masking the two write bits makes the label mean exactly one thing: crond is
  # ignoring this file, so ZERO pipeline runs. It can then be escalated.
  perms="$(stat -c '%a' "$CRON_FILE" 2>/dev/null || echo '')"
  # Validate BEFORE the arithmetic. `$((8#$perms))` on anything that is not a
  # run of octal digits is a bash FATAL ("value too great for base"), and with
  # `set -uo pipefail` (no `-e`) that aborts the arithmetic silently and skips
  # the label entirely — fail-OPEN, where the old `!= 644` test was fail-closed.
  # A reader that cannot classify must say so, not stay quiet.
  if [[ ! "$perms" =~ ^[0-7]+$ ]]; then
    add_label 'cron_file_perms:unreadable'
  elif [[ $((8#$perms & 0022)) -ne 0 ]]; then
    add_label "cron_file_perms:$perms"
  fi
  cr_count="$(tr -cd '\r' <"$CRON_FILE" | wc -c)"
  [[ "$cr_count" -eq 0 ]] || add_label "cron_file_crlf:$cr_count"

  for p in "${PIPELINES[@]}"; do
    if grep -qE "fxmily-worker[[:space:]]+${p}([[:space:]]|$)" "$CRON_FILE"; then
      TASKS_OK=$((TASKS_OK + 1))
    else
      add_label "task_missing:$p"
    fi
  done
  grep -q 'fxmily-worker-watchdog' "$CRON_FILE" || add_label 'task_missing:watchdog'
fi

# --- 3. AUTH (live) ----------------------------------------------------------
# Zero quota cost: `claude auth status --json` reads ~/.claude/.credentials.json.
#
# OBSERVATION-AWARE, and this matters. `claude_auth:logged_out` is escalated to
# RED by health.ts (`criticalLabels`) because it means "the AI is mute". That is
# TRUE once this host owns generation — and FALSE during the doublon window,
# where the PC is still master and generating normally. Raising the critical
# label then would be a false alarm, and a board that cries wolf during a
# planned migration is a board nobody reads afterwards. So while
# FXMILY_WORKER_DRY_RUN=1 the same fact is reported under a non-critical label:
# still visible, still counted in `errors` (→ amber), never a phantom incident.
OBSERVATION=false
# `:-1`, NOT `:-0` — and this default has to match the wrapper's, exactly.
# `fxmily-worker:122` gates the run on `${FXMILY_WORKER_DRY_RUN:-1}`, so on a
# host where the key is absent (rebuilt, restored, installer never run in
# `install` mode) the batches DO run in observation. Reading `:-0` here made the
# watchdog believe the opposite and emit `claude_auth:logged_out` — a CRITICAL
# label — for a host that was behaving correctly: red board, 503, cron-watch
# failing, on nothing. The wrapper already carries this warning for its own
# MODE_TAG (`fxmily-worker:183`); the watchdog was making that very mistake.
[[ "${FXMILY_WORKER_DRY_RUN:-1}" == "1" ]] && OBSERVATION=true

if ! command -v claude >/dev/null 2>&1; then
  add_label 'claude_bin_missing'
else
  AUTH_JSON="$(claude auth status --json 2>/dev/null || true)"
  LOGGED_IN="$(printf '%s' "$AUTH_JSON" | jq -r '.loggedIn // false' 2>/dev/null || echo false)"
  if [[ "$LOGGED_IN" != "true" ]]; then
    if [[ "$OBSERVATION" == "true" ]]; then
      add_label 'claude_auth:observation_pending'
    else
      add_label 'claude_auth:logged_out'
    fi
  fi
fi

# --- 4. RUNS -----------------------------------------------------------------
NOW_EPOCH="$(date +%s)"
# Above the 60-minute quota cooldown, below every pipeline period except the
# three that tick in minutes — see the AGE GATE comment in the loop for why a
# quota state read from a monthly pipeline is a fossil.
QUOTA_FRESH_MIN="${FXMILY_WORKER_QUOTA_FRESH_MIN:-90}"
QUOTA_SEEN=false
# The dedicated-account guard is machine-wide, like the quota one: every
# pipeline skips for the same reason, so reporting it once is the honest count.
ACCOUNT_SEEN=false
for p in "${PIPELINES[@]}"; do
  status_file="$LOG_DIR/${p}.status.json"
  [[ -r "$status_file" ]] || continue
  # A status.json that does not PARSE makes this whole loop silent. Every read
  # below is `jq … || echo <default>`, and those defaults conspire: `ok` falls
  # back to false while `code` falls back to 0, and the `batch_failed` branch
  # needs `code != 0`. So a corrupted file satisfies no branch at all and reads
  # exactly like a healthy tick — the board stays green on a pipeline whose own
  # status is unreadable. Validate ONCE, up front, and SAY SO when it fails: an
  # instrument that cannot read its input must report that, never a verdict.
  # `run-batch.sh` interpolates values into a JSON heredoc, so a value carrying
  # a quote is enough to produce this — it is not a theoretical corruption.
  if ! jq -e 'type == "object"' "$status_file" >/dev/null 2>&1; then
    add_label "status_unreadable:${p}"
    continue
  fi
  ok="$(jq -r '.ok // false' "$status_file" 2>/dev/null || echo false)"
  code="$(jq -r '.exitCode // 0' "$status_file" 2>/dev/null || echo 0)"
  capped="$(jq -r '.quotaCapped // false' "$status_file" 2>/dev/null || echo false)"
  # `skipped` was written by run-batch.sh and read by NOBODY on this side. The
  # dedicated-account guard skips the tick benignly (exit 0, ok:true) precisely
  # so nothing is lost — which means the age heartbeat and the ok/exitCode pair
  # both stay green, and this field is the ONLY place the reason survives.
  skipped="$(jq -r '.skipped // ""' "$status_file" 2>/dev/null || echo "")"
  if [[ "$ACCOUNT_SEEN" == "false" ]]; then
    case "$skipped" in
      account_unexpected)
        # The signed-in account is not the one this worker is dedicated to.
        # Severity is decided by the BOARD, not here, and it depends on which
        # host owns generation: informational while the PC is still master (a
        # server-side account fault holds up nobody), blocking once the server
        # owns it. An earlier version of this comment claimed "critical even in
        # observation" — that contradicted `health.ts`, which downgrades any
        # label emitted by an observing server to `pending`, exactly as it does
        # for `claude_auth:observation_pending`.
        add_label 'claude_account:unexpected'
        ACCOUNT_SEEN=true
        ;;
      account_guard_misconfigured)
        # The configured digest is not a digest. Distinct from `unexpected` on
        # purpose: telling the operator to reconnect the account would send them
        # to fix the one thing that is not broken.
        add_label 'claude_account:misconfigured'
        ACCOUNT_SEEN=true
        ;;
      account_unverifiable)
        # The guard is configured but the session carries no identity to compare
        # (an environment-variable token returns no address). Nothing generates,
        # so this is not informational.
        add_label 'claude_account:unverifiable'
        ACCOUNT_SEEN=true
        ;;
    esac
  fi
  # QUOTA — two states, one meaning, and only one of them was being read.
  #
  # `quotaCapped:true` is written by the tick that HIT the cap. `skipped:
  # "quota_cooldown"` is written by every tick for the 60 minutes that follow
  # (run-batch.sh:190) — and that is the state the machine is in for most of
  # each hour. Reading only the first meant the board carried NO quota label at
  # all for roughly 40 minutes out of every 60, and then flickered one on.
  #
  # This is the same defect PR #594 closed one field over: `skipped` was
  # "written by run-batch.sh and read by NOBODY". It was fixed for
  # `account_unexpected` and left open for its sibling.
  #
  # WHY THE BOARD CANNOT FALL BACK ON AGE HERE, which is what made the silence
  # total rather than partial: a capped tick PULLS its envelope before the first
  # `claude --print`, so it refreshes `<pipeline>.batch.pulled` itself. The
  # cooldown is 60 min and the tightest server tolerance is 240 min, so the age
  # NEVER reaches red however long the cap lasts. `health.ts` asserted the
  # opposite in a comment ("if it lasts, the pull heartbeats go stale and red on
  # age"); that comment is corrected in the same change as this one.
  #
  # AGE GATE, and it is NOT a contradiction of the header. Step 4 ignores
  # staleness on purpose for `ok`/`exitCode`, because "this pipeline stopped
  # running" is measured by the age heartbeat instead. That reasoning does not
  # carry to the quota state, and the difference is CADENCE: `monthly` ticks on
  # the 1st, `profile` on the 2nd, `weekly` on Sunday. A `quota_cooldown` written
  # by `monthly` on the 1st is still the newest thing that file will ever say on
  # the 28th. Without this gate the episode below would be held open for a MONTH
  # on a perfectly healthy host — red board, /api/cron/health 503, cron-watch
  # failing every hour. That is strictly worse than the silence it replaces, and
  # it was found by an adversarial review that EXECUTED this loop against a
  # fabricated tree rather than reading it.
  #
  # 90 minutes, because the cooldown is 60: a cap that is genuinely current is
  # re-witnessed within minutes by `verification` (5 min), `onboarding` (20) or
  # `seances` (30). A quota state older than that is a fossil, not a state.
  status_age_min=$(((NOW_EPOCH - $(stat -c '%Y' "$status_file" 2>/dev/null || echo "$NOW_EPOCH")) / 60))
  if [[ "$QUOTA_SEEN" == "false" ]] &&
    [[ "$status_age_min" -le "$QUOTA_FRESH_MIN" ]] &&
    { [[ "$capped" == "true" ]] || [[ "$skipped" == "quota_cooldown" ]]; }; then
    add_label 'claude_quota:capped'
    QUOTA_SEEN=true
  fi
  if [[ "$ok" != "true" && "$code" != "0" && "$code" != "75" ]]; then
    # Observation-aware, for the SAME reason as the auth label above. This one
    # is the single most important signal the board has: the batch RAN, pulled
    # its envelope (so `<pipeline>.batch.pulled` is fresh and the age-based
    # heartbeat stays GREEN) and then failed to generate. Age can never catch
    # that — only this label can. So on a host that owns generation it is a red
    # incident.
    #
    # But during the observation window nobody is logged in to `claude` yet, so
    # the four generators fail by construction on every single tick. Escalating
    # then would paint the board red permanently through a planned migration,
    # which is how a board stops being read. Same fact, non-critical name.
    if [[ "$OBSERVATION" == "true" ]]; then
      add_label "batch_failed_observation:${p}:${code}"
    else
      add_label "batch_failed:${p}:${code}"
    fi
  fi
done

# --- 4-bis. Is the quota pause still TRANSIENT? ------------------------------
# A cap that clears inside one window is a pause and must stay non-critical: it
# resolves on its own, and a board that goes red on every normal pause is a
# board nobody reads. A cap that is STILL there hours later is an outage with a
# calm name — members wait, nothing is generated, and every other signal on the
# board reads healthy for the reasons written above the label.
#
# The duration is measured HERE and nowhere else, because this is the only
# component that observes the whole machine on a fixed cadence. The episode file
# is created on the first tick that sees a quota state and REMOVED on the first
# tick that sees none — so its age is exactly "how long the board has been
# continuously in a quota state". Nothing is asked of run-batch.sh or of the
# batch core, and no counter can drift: the file either exists or it does not.
#
# It also self-heals across a reboot or a manual `rm`: a stale file only ever
# makes the episode look YOUNGER after a clear, never older, because the clear
# is what deletes it.
#
# TWO LIMITS, STATED, because a guard whose name promises more than its proof is
# an argument for not looking:
#
#   · CONTINUOUS, not cumulative. One tick with no quota state deletes the file.
#     An account drained in bursts — capped, cooldown, one clean tick because
#     that pipeline's cohort happened to be empty, capped again — never reaches
#     six continuous hours and is therefore never reported as stalled, however
#     little it actually generates. This misses a real outage; it does not
#     invent one, so it is strictly better than today's total silence. Closing it
#     needs a cumulative measure over a rolling window, which needs a count of
#     what was PRODUCED, which lives in the batch core. Named, not pretended.
#   · Best-effort write. If `$LOG_DIR` is not writable the file never appears and
#     nothing escalates. The directory is created and owned by the installer, so
#     this is a disk-full or permissions incident — which the host's own disk
#     watchdog reports separately.
QUOTA_EPISODE="$LOG_DIR/quota-episode.start"
QUOTA_STALL_HOURS="${FXMILY_WORKER_QUOTA_STALL_HOURS:-6}"
if [[ "$QUOTA_SEEN" == "true" ]]; then
  [[ -f "$QUOTA_EPISODE" ]] || date +%s >"$QUOTA_EPISODE" 2>/dev/null || true
  episode_start="$(tr -dc '0-9' <"$QUOTA_EPISODE" 2>/dev/null || true)"
  # AN INSTRUMENT THAT CANNOT MEASURE MUST SAY SO. Absent means the write failed
  # (unwritable dir, disk full); EMPTY is worse and absorbing — an interrupted
  # write leaves a zero-byte file, `-f` then reports it present so it is never
  # rewritten, and the only `rm` sits on the "no quota state" branch which by
  # definition does not run during the outage. Silently, forever, the escalation
  # is off. This file already states the principle 180 lines up: "a reader that
  # cannot classify must say so, not stay quiet".
  if [[ -z "$episode_start" ]]; then
    add_label 'quota_episode_unwritable'
    # Self-heal the absorbing state: a zero-byte file is not data, it is debris.
    rm -f "$QUOTA_EPISODE" 2>/dev/null || true
  fi
  if [[ -n "$episode_start" ]]; then
    episode_h=$(((  $(date +%s) - episode_start ) / 3600))
    # Six hours, chosen ABOVE the five-hour subscription window on purpose: one
    # exhausted window refills by itself and must not cry wolf, while still
    # being capped after six hours means the account is being drained faster
    # than it refills — which no cooldown will ever fix, and which the operator
    # has to know about because the fix is a decision, not a retry.
    if [[ "$episode_h" -ge "$QUOTA_STALL_HOURS" ]]; then
      add_label "claude_quota:stalled:${episode_h}h"
    fi
  fi
else
  rm -f "$QUOTA_EPISODE" 2>/dev/null || true
fi

# --- 5. LOCK -----------------------------------------------------------------
if [[ -d "$LOCK_DIR" ]]; then
  if [[ -n "$(find "$LOCK_DIR" -maxdepth 0 -mmin +360 2>/dev/null)" ]]; then
    add_label 'lock_stale'
  fi
fi

# --- 6. REPORT ---------------------------------------------------------------
ERRORS="${#ERROR_LABELS[@]}"
SUMMARY="SUMMARY checked=${#PIPELINES[@]} ok=$TASKS_OK repaired=0 errors=$ERRORS"
if [[ "$ERRORS" -gt 0 ]]; then
  # `IFS='; '` would join with `;` only — bash uses the FIRST character of IFS
  # for `${arr[*]}`. Build the separator explicitly instead.
  SUMMARY+=" [$(printf '%s; ' "${ERROR_LABELS[@]}" | sed 's/; $//')]"
fi
log "$SUMMARY"

if [[ -z "$ADMIN_TOKEN" || "${#ADMIN_TOKEN}" -lt 32 ]]; then
  log 'ERROR heartbeat impossible: FXMILY_ADMIN_TOKEN missing/short in worker.env.'
  exit 1
fi

# The board keeps ONE heartbeat slot for "the worker". During the doublon window
# TWO watchdogs write to it (the PC's and this one), so the version string
# carries the discriminator: whoever reads the audit metadata can tell which
# host wrote the row, and whether it was still in observation. ≤20 chars (Zod).
#
# TWO MARKERS, because they answer TWO questions and only one of them was asked.
#   `-srv` = WHICH MACHINE. Unconditional. The board resolves a remediation
#            command from it, and a command is machine-specific.
#   `-obs` = WHICH MODE. Conditional. It says nothing about the host.
#
# They were conflated, and the gap was real: the switchover flips DRY_RUN to 0
# on THIS machine (step 1) and `WORKER_HOST` to `server` in the app (step 3), in
# that order, with a `docker compose restart web` between them. Between those two
# gestures this watchdog emitted a bare `j9-1.0` while the board still read
# `WORKER_HOST=pc` — so a Linux fault reported here produced a PowerShell command
# aimed at the PC. Exactly the defect the `-obs` reader was added to remove,
# surviving in the one window where the server has just started persisting.
WATCHDOG_VERSION="${WATCHDOG_VERSION}-srv"
[[ "$OBSERVATION" == "true" ]] && WATCHDOG_VERSION="${WATCHDOG_VERSION}-obs"

PAYLOAD="$(jq -nc \
  --argjson checked "${#PIPELINES[@]}" \
  --argjson ok "$TASKS_OK" \
  --argjson errors "$ERRORS" \
  --arg version "$WATCHDOG_VERSION" \
  --argjson labels "$(printf '%s\n' ${ERROR_LABELS[@]+"${ERROR_LABELS[@]}"} \
    | head -20 | jq -R . | jq -s 'map(select(length > 0))')" \
  '{tasksChecked: $checked, tasksOk: $ok, repaired: 0, errors: $errors, watchdogVersion: $version}
   + (if ($labels | length) > 0 then {errorLabels: $labels} else {} end)')"

HTTP_CODE="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
  --max-time 30 --retry 2 --retry-delay 5 \
  -X POST \
  -H "X-Admin-Token: ${ADMIN_TOKEN}" \
  -H 'Content-Type: application/json' \
  -H 'User-Agent: fxmily-worker-watchdog/1.0' \
  --data "$PAYLOAD" \
  "${BASE_URL%/}/api/admin/worker-watchdog/heartbeat" || echo '000')"

if [[ "$HTTP_CODE" == "200" ]]; then
  log "heartbeat delivered (http=200)"
  exit 0
fi
log "ERROR heartbeat NOT delivered (http=$HTTP_CODE)"
exit 1
